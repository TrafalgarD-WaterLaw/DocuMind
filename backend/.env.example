# 复制为 .env 并填入真实值;.env 不入库

# ── 服务 ──
HOST=0.0.0.0
PORT=5172

# ── LLM(DeepSeek)──
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ── 文档图片描述(Qwen-VL,可选;无 key 时降级为文件名占位)──
DASHSCOPE_API_KEY=your_dashscope_api_key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_CAPTION_MODEL=qwen-vl-max-latest

# ── Neo4j 图谱(可选;未配置时图谱功能静默降级)──
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# ── 本地模型路径(默认值见 core/config.py,按需覆盖)──
# BGE_MODEL_PATH=D:/cache/modelscope/models/BAAI--bge-small-zh-v1.5/snapshots/master
# RERANKER_MODEL_PATH=D:/cache/modelscope/models/BAAI--bge-reranker-v2-m3/snapshots/master
# CLIP_MODEL_PATH=D:/cache/modelscope/models/OFA-Sys--chinese-clip-vit-base-patch16
